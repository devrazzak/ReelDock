{
    "name": "reeldock",
    "version": "1.0.0",
    "private": true,
    "description": "Chrome extension that keeps Facebook Reels playing in a background tab and moves to the next Reel automatically.",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "pnpm build && node tests/e2e/run-e2e.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "build:live": "vite build --config tests/live/vite.config.ts",
        "package": "pnpm build && mkdir -p release && cd dist && zip -qr ../release/reeldock-$npm_package_version.zip . && echo Created release/reeldock-$npm_package_version.zip",
        "store:screenshots": "pnpm build && node scripts/store-screenshots.mjs"
    },
    "dependencies": {
        "@rax-ds/ui": "^0.13.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@crxjs/vite-plugin": "^3.0.0",
        "@tailwindcss/vite": "^4.3.5",
        "@types/chrome": "^0.3.7",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "happy-dom": "^21.0.4",
        "prettier": "^3.10.1",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    }
}
